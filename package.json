{
  "name": "new-tab-display",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "dev:showcase": "vite --config vite.showcase.config.ts --mode showcase",
    "build:showcase": "tsc -b && vite build --config vite.showcase.config.ts --mode showcase",
    "preview:showcase": "vite preview --config vite.showcase.config.ts --mode showcase",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:extension:ui": "playwright test tests/extension src/widgets --project=chromium-mac --ui",
    "test:smoke": "playwright test tests/smoke/newtab.smoke.spec.ts --project=chromium-mac",
    "test:smoke:local": "playwright test tests/smoke/newtab.smoke.spec.ts --project=chromium-mac",
    "test:extension": "playwright test tests/extension src/widgets --project=chromium-mac",
    "test:extension:local": "playwright test tests/extension src/widgets --project=chromium-mac",
    "test:extension:update-snapshots": "playwright test tests/extension src/widgets --project=chromium-mac --update-snapshots",
    "test:smoke:ci": "xvfb-run -a playwright test tests/smoke/newtab.smoke.spec.ts --project=chromium-ci",
    "test:extension:ci": "xvfb-run -a playwright test tests/extension src/widgets --project=chromium-ci",
    "test:extension:update-snapshots:ci": "xvfb-run -a playwright test tests/extension src/widgets --project=chromium-ci --update-snapshots"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tailwindcss/vite": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.8.18",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.2",
    "react-i18next": "^16.5.8",
    "react-resizable": "^3.1.3",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^2.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.3",
    "@vitest/ui": "4.1.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.1.2"
  }
}
